# Template file for 'equibop'
pkgname=equibop
version=3.1.9
revision=1
archs="x86_64"
depends="libX11 libxcb libXcomposite libXcursor libXdamage libXext libXfixes libXi libXrender libXtst nss alsa-lib pango at-spi2-core libcups"
short_desc="Equibop Desktop Client"
maintainer="Shehata-git <shehataofficialmail@gmail.com>"
license="custom:Proprietary"
homepage="https://github.com/Equicord/Equibop"
distfiles="https://github.com/Equicord/Equibop/releases/download/v${version}/equibop-${version}.tar.gz"
checksum="e344946af86a85c60bc4e7cc9efbfc3ac3fee7c41634bce1744bb41a6c0b469f"

repository=nonfree
restricted=yes
nostrip=yes

do_install() {
	local opt_path="opt/equibop"
	vmkdir "${opt_path}"

	# Copies everything including the equibop binary, resources/arrpc, locales, etc.
	vcopy * "${opt_path}/"

	vmkdir usr/bin

	# Create a wrapper script that reads the flags conf file
	cat <<EOF > ${DESTDIR}/usr/bin/equibop
#!/bin/sh
XDG_CONFIG_HOME="\${XDG_CONFIG_HOME:-\$HOME/.config}"
FLAGS_FILE="\$XDG_CONFIG_HOME/equibop-flags.conf"
USER_FLAGS=""

if [ -f "\$FLAGS_FILE" ]; then
    # Read non-comment lines and combine them into a single string
    USER_FLAGS=\$(grep -v '^#' "\$FLAGS_FILE" | tr '\n' ' ')
fi

# --wayland forces native Ozone platform + VaapiVideoDecodeLinuxGL
exec /opt/equibop/equibop \$USER_FLAGS "\$@"
EOF

	chmod +x ${DESTDIR}/usr/bin/equibop

	# Generate the .desktop file
	vmkdir usr/share/applications
	cat <<EOF > ${DESTDIR}/usr/share/applications/equibop.desktop
[Desktop Entry]
Name=Equibop
Comment=Equibop Desktop Client
Exec=/usr/bin/equibop %U
Icon=equibop
Type=Application
Terminal=false
Categories=Network;InstantMessaging;Chat;
StartupWMClass=equibop
EOF

	# Fetch and install the icon
	curl -sL "https://raw.githubusercontent.com/Equicord/Equibop/refs/heads/main/static/icon.png" -o equibop.png && vinstall equibop.png 644 usr/share/pixmaps equibop.png
}
